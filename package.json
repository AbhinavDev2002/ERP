{
  "name": "erp",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=10.15.1"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch": "depcruise --config .dependency-cruiser.cjs apps packages",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch && pnpm test && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
