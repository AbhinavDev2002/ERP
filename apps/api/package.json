{
  "name": "@erp/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "node --env-file=../../.env.example ./node_modules/prisma/build/index.js generate --schema=prisma/schema && tsc --noEmit",
    "build": "node --env-file=../../.env.example ./node_modules/prisma/build/index.js generate --schema=prisma/schema && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "node --env-file=../../.env.example ./node_modules/prisma/build/index.js generate --schema=prisma/schema && node --env-file=../../.env.example ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@erp/contracts": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@prisma/client": "^6.16.3",
    "better-auth": "^1.7.7",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "pino": "^9.9.5",
    "redis": "^6.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@erp/eslint-config": "workspace:*",
    "@erp/typescript-config": "workspace:*",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "eslint": "^9.36.0",
    "prisma": "^6.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
